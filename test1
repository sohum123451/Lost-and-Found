# Email Validator Helper
def is_valid_student_email(email):
    # Allows standard institutional student formats
    pattern = r"^[a-zA-Z0-9_.+-]+@([a-zA-Z0-9-]+\.)*(vitstudent\.ac\.in|edu|ac\.in)$"
    return re.match(pattern, email) is not None

