# ==================== TAB 1: AI SMART MATCH ====================
with tab_search:
    st.subheader("Automated Semantic Inventory Scan")
    st.write("Enter an unstructured description of what you lost. Gemini will scan registered campus deposits for potential matches.")
    
    query = st.text_area("Item Description & Context", placeholder="e.g., Left a dark blue Dell laptop bag with a Casio calculator inside SJT 4th floor near room 412.")
    
    if st.button("Run AI Matcher", type="primary"):
        if not query.strip():
            st.warning("Please provide descriptive keywords.")
        else:
            with st.spinner("Querying institutional database with Gemini..."):
                response = db.table("campus_inventory").select("*").eq("status", "Unclaimed").execute()
                items = response.data
                
                if not items:
                    st.info("No unclaimed items currently registered in the database.")
                else:
                    context = "\n".join([
                        f"ID: {i['id']} | Category: {i['category']} | Title: {i['item_title']} | Zone: {i['campus_zone']} | Details: {i['description']}" 
                        for i in items
                    ])
                    
                    prompt = f"""
                    You are an official campus lost-and-found matching system.
                    Current Active Inventory:
                    {context}

                    User Query: "{query}"

                    Instructions:
                    1. Check if any item in the inventory likely matches the query.
                    2. If a match exists, output the Item ID, Title, Campus Zone, and instructions to visit the Security Desk to claim.
                    3. If no clear match is found, provide a list of nearest security desks for the mentioned campus zone.
                    4. Maintain a formal, official tone.
                    """
                    
                    try:
                        ai_res = ai_client.models.generate_content(
                            model="gemini-3.6-flash",
                            contents=prompt
                        )
                        st.success("Analysis Complete")
                        st.markdown(ai_res.text)
                    except Exception as e:
                        st.error(f"AI Service Error: {e}")

# ==================== TAB 2: REPORT ITEM ====================
with tab_report:
    st.subheader("Official Deposit & Incident Report")
    
    if not user_email or not is_valid_student_email(user_email):
        st.warning("⚠️ Please provide a valid institutional email (@vitstudent.ac.in or @ac.in) in the sidebar to file a report.")
    else:
        with st.form("official_report_form", clear_on_submit=True):
            c1, c2 = st.columns(2)
            with c1:
                cat = st.selectbox("Record Type", ["Found Item (Handed In)", "Lost Incident", "Resource for Student Redistribution"])
                title = st.text_input("Item Designation / Name *", placeholder="e.g., Casio Scientific Calculator FX-991CW")
                zone = st.selectbox("Campus Zone / Block *", [
                    "SJT (Silver Jubilee Tower)", "TT (Technology Tower)", "MB (Main Building)", 
                    "PRP Block", "Central Library", "Foodys / Gazebo", "Men's Hostels", "Ladies Hostels"
                ])
            with c2:
                contact = st.text_input("Contact Number *", placeholder="10-digit mobile number")
                secret_detail = st.text_input("Verification Marker (Private)", placeholder="e.g., Specific sticker or lock pattern (Used to verify owner)")
                desc = st.text_area("Public Description *", placeholder="Mention color, brand, condition, and where it was deposited.")

            submit = st.form_submit_button("Register Record in Official Database")
            if submit:
                if title and contact and desc:
                    record = {
                        "category": cat,
                        "item_title": title,
                        "campus_zone": zone,
                        "finder_email": user_email,
                        "contact_num": contact,
                        "description": desc,
                        "status": "Unclaimed",
                        "verification_hint": secret_detail
                    }
                    db.table("campus_inventory").insert(record).execute()
                    st.success("Record successfully logged in the campus inventory system.")
                else:
                    st.error("Please fill in all mandatory fields (*).")

