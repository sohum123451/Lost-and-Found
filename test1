# ==================== TAB 4: ADMIN CONSOLE ====================
with tab_admin:
    st.subheader("Security & Warden Operations Console")
    if user_role != "Security Desk Admin" or admin_pin != "1234": # Demo PIN
        st.error("🔒 Restricted Area. Select 'Security Desk Admin' in sidebar and enter PIN (Demo PIN: 1234).")
    else:
        st.success("Administrative privileges authenticated.")
        admin_res = db.table("campus_inventory").select("*").execute()
        all_records = admin_res.data
        
        if all_records:
            for item in all_records:
                with st.expander(f"Record #{item['id']}: {item['item_title']} ({item['status']})"):
                    st.write(f"**Campus Zone:** {item['campus_zone']}")
                    st.write(f"**Finder Email:** {item['finder_email']} | **Contact:** {item['contact_num']}")
                    st.write(f"**Public Description:** {item['description']}")
                    st.warning(f"**Confidential Verification Marker:** {item.get('verification_hint', 'None provided')}")
                    
                    col_a, col_b = st.columns(2)
                    with col_a:
                        if st.button(f"Mark as Resolved / Claimed", key=f"res_{item['id']}"):
                            db.table("campus_inventory").update({"status": "Resolved"}).eq("id", item['id']).execute()
                            st.rerun()
                    with col_b:
                        if st.button(f"Delete Entry", key=f"del_{item['id']}"):
                            db.table("campus_inventory").delete().eq("id", item['id']).execute()
                            st.rerun()